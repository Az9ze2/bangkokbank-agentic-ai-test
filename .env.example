# Copy this file to .env and fill in ONE of the two options below.
# OPENAI_API_KEY takes precedence over the AZURE_OPENAI_* vars if both are set.

# Option A: standard OpenAI API key (platform.openai.com dashboard)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Option B: Bangkok Bank's Azure OpenAI deployment
# Request the subscription key from kanit.mekritthikrai@bangkokbank.com
AZURE_OPENAI_ENDPOINT=https://oaibblinnocandiddate01.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# Update this if Azure requires a different API version for gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
